{
  "name": "postgres-explain-visualizer",
  "displayName": "Postgres Explain Visualizer",
  "description": "Turn the output of PostgreSQL's EXPLAIN into an interactive plan diagram, inside VS Code and without sending the plan anywhere.",
  "version": "1.0.0",
  "publisher": "ShaikMohammadMujeeb",
  "author": {
    "name": "Mujeeb"
  },
  "private": true,
  "license": "MIT AND PostgreSQL",
  "repository": {
    "type": "git",
    "url": "https://github.com/mujeeb-sk/postgres-explain-visualizer.git"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "postgres",
    "postgresql",
    "explain",
    "explain analyze",
    "query plan"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "explainVisualizer.open",
        "title": "Open Explain Visualizer",
        "category": "Postgres"
      },
      {
        "command": "explainVisualizer.visualize",
        "title": "Visualize EXPLAIN Plan",
        "category": "Postgres"
      },
      {
        "command": "explainVisualizer.visualizeTerminalSelection",
        "title": "Visualize EXPLAIN Plan",
        "category": "Postgres"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "explainVisualizer.visualizeTerminalSelection",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "explainVisualizer.visualize",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@10"
        }
      ],
      "terminal/context": [
        {
          "command": "explainVisualizer.visualizeTerminalSelection",
          "when": "terminalTextSelected",
          "group": "9_explainVisualizer"
        }
      ]
    }
  },
  "scripts": {
    "compile": "vue-tsc --noEmit && vite build && vite build --mode extension",
    "test:unit": "LANG=en_US.UTF-8 vitest --run",
    "test:integration": "npm run compile && tsc -p src/test/integration && node out/test/integration/runTests.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --out .."
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@types/d3": "^7.4.3",
    "@types/humanize-duration": "^3.27.1",
    "@types/lodash": "^4.14.202",
    "@types/node": "^26.1.2",
    "@types/vscode": "~1.90.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.1.0",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.2.0",
    "bootstrap": "^5.3.8",
    "d3": "^7.9.0",
    "d3-flextree": "^2.1.2",
    "highlight.js": "^11.11.1",
    "humanize-duration": "^3.33.2",
    "jsdom": "^30.0.0",
    "lodash": "^4.18.1",
    "motion": "^12.29.2",
    "sass": "^1.58.0",
    "splitpanes": "^4.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vue": "^3.5.44",
    "vue-clipboard3": "^2.0.0",
    "vue-tippy": "^6.7.1",
    "vue-tsc": "^3.3.8"
  }
}
